{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talk",
  "version": "0.11.0-dev",
  "identifier": "com.avpbynf.t4lk",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Talk",
        "width": 801,
        "height": 854,
        "minWidth": 801,
        "minHeight": 854,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:* http://127.0.0.1:* http://172.* http://192.168.* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFOUQ5RDNBQjlGQTEzMUYKUldRZkUvcTVPcDJkanMvbTRaa0x0Q0ZleTZJd1ZsQ2ZiZ3FHWTdkOEJBRWk3ZDRqaUc4anBQdUcK",
      "endpoints": [
        "https://github.com/avpbynf/Talk-Client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
